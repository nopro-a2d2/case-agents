# Copy to `.env` and fill in. Real environment variables override these.

# --- Required: GCP project + region ---
GCP_PROJECT=
# Vertex location. Claude Sonnet on Vertex is region-restricted.
# Common: us-east5, us-central1, europe-west1
VERTEX_LOCATION=us-east5

# --- Required: service-account key (the only supported auth path) ---
# Absolute path to a service-account JSON key. case-agent does NOT fall back
# to gcloud ADC: keep credential resolution explicit and CI-friendly.
#
# How to get the key:
#   1. GCP Console -> IAM & Admin -> Service Accounts -> Create
#   2. Grant: roles/aiplatform.user (Vertex AI User)
#   3. Keys -> Add Key -> JSON  (download)
#   4. Move the file somewhere outside the repo and chmod 600
#
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/case-agent-sa.json

# --- Optional model overrides ---
# Defaults match case_agent/model/vertex.py.
# CASE_AGENT_HEAVY_MODEL=claude-sonnet-4-5@20250929
# CASE_AGENT_LIGHT_MODEL=gemini-3-flash-preview
# CASE_AGENT_EMBED_MODEL=gemini-embedding-2
# Embedding output dimension. Must match the prebuilt index manifest's `dim`.
# CASE_AGENT_EMBED_DIM=768

# --- Override .env discovery (rare) ---
# CASE_AGENT_DOTENV=/absolute/path/to/another.env
